{
  "name": "app_odonto",
  "version": "1.0.2",
  "description": "Sistema de Gestão Odontológica OdontoCO",
  "author": "OdontoCO",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "pre-dist": "npm run build && powershell -NoProfile -Command \"Copy-Item -Recurse -Force .next/static .next/standalone/.next/static; Copy-Item -Recurse -Force public .next/standalone/public; if (Test-Path .next/standalone/node_modules) { Rename-Item -Path .next/standalone/node_modules -NewName next_modules -Force }\"",
    "dist": "npm run pre-dist && electron-builder --win",
    "clean-cache": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force $env:LOCALAPPDATA\\electron-builder\\Cache\""
  },
  "build": {
    "appId": "com.odontoco.app",
    "productName": "OdontOC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "database/app_odonto.sqlite",
      "Imagens/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Imagens/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OdontOC",
      "artifactName": "OdontOC_Distrib_Clean_v${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
